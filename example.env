# WeatherLink API credentials — found at weatherlink.com > Account > API Keys
WL_API_KEY=your_api_key
WL_API_SECRET=your_api_secret
WL_STATION_ID=your_station_id

# Timezone — full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Los_Angeles

# Dashboard port (default 8081)
PORT=8081

# Gmail credentials for daily email reports (optional — leave blank to disable)
WL_EMAIL_SENDER=example@gmail.com
WL_EMAIL_PASSWORD=app-specific-password
WL_EMAIL_RECIPIENTS=recipient1@gmail.com,recipient2@gmail.com
